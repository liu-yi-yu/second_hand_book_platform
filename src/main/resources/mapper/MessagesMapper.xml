<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.tlais.yutest1.mapper.MessagesMapper">
    <select id="selectByOrderId" resultType="org.tlais.yutest1.domain.entity.Message">
        select * from messages where order_id = #{orderId}
    </select>
    <!-- 未读消息：只统计「我是接收方」的消息；再加 sender_id != receiver_id，
         排除自买订单产生的"自己发给自己"消息（防止未读数把自己发的算进去） -->
    <select id="selectUnread" resultType="org.tlais.yutest1.domain.entity.Message">
        select * from messages where is_read = 0 and receiver_id = #{currentId}
          and sender_id != receiver_id
        order by created_at desc
    </select>

    <!--
        新增：保存一条消息
        注意：id 是数据库自增主键(bigint)，所以这里不插入 id 字段，让数据库自动生成
    -->
    <insert id="insert" parameterType="org.tlais.yutest1.domain.entity.Message">
        insert into messages (order_id, sender_id, receiver_id, content, client_id, created_at)
        values (#{orderId}, #{senderId}, #{receiverId}, #{content}, #{clientId}, #{createdAt})
    </insert>
</mapper>
